# OpenAI-compatible relay (recommended for Curriculum v2)
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://your-relay.example/v1
OPENAI_MODEL=your-model-name

# Legacy aliases (optional; stage-01 also reads these if OPENAI_* unset)
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=deepseek-v4-flash
